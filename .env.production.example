# ============================================================================
# PRODUÇÃO — LJ SmartClinic
# ============================================================================
#
# COPIE PARA `.env` NA VPS E TROQUE TUDO QUE ESTIVER MARCADO <<<.
#
# Este arquivo é o MODELO e não deve ser editado com valores reais: ele é
# versionado no git, e o `.env` de verdade está no .gitignore. A ideia é que a
# VPS receba o repositório inteiro e ninguém precise lembrar de quais chaves
# existem — só o que preencher.
#
#     cp .env.production.example .env
#     php artisan key:generate
#
# Regra: nenhuma senha deste arquivo pode ser a mesma de outro ambiente. A
# senha do super admin que vivia em texto puro no check_pwd.php é a prova de
# que reaproveitar credencial custa caro.

# --- Aplicação --------------------------------------------------------------

APP_NAME="LJ SmartClinic"
APP_TAGLINE="Plataforma de Gestão para Clínicas"

# production + debug desligado é o que impede que um erro mostre o .env,
# a senha do banco e o stack trace para qualquer visitante.
APP_ENV=production
APP_DEBUG=false

# Gerada por `php artisan key:generate`. <<<
APP_KEY=

# Scheme + domínio definitivos. Sem HTTPS o SESSION_SECURE_COOKIE abaixo
# impede o navegador de mandar o cookie de sessão.
APP_URL=https://seudominio.com.br

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Mais caro por hash, mais lento para o usuário. 12 é o mínimo aceitável.
BCRYPT_ROUNDS=12

# `daily` em vez de `single`: o arquivo de log em produção cresce sem limite e
# enche o disco da VPS. Em log de nível debug, um erro de WhatsApp por hora
# estoura o espaço em dias.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Quantos dias de arquivo `daily` são mantidos. O default do config é 14;
# com log de aplicação em produção, dois semanas é pouco: um erro de
# integração que só aparece na segunda-feira já foi rotacionado.
LOG_DAILY_DAYS=30

# --- Banco central ----------------------------------------------------------
#
# Um usuário dedicado, NÃO root. O `.env` local usa root porque em
# desenvolvimento ele é prático; em produção, root na aplicação significa que
# uma injeção de SQL vira servidor inteiro.
#
# O usuário precisa de CREATE DATABASE porque o painel cria um banco por
# clínica. Veja deploy/vps/01-mysql.sql.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_central
DB_USERNAME=saas <<<
DB_PASSWORD= <<<

# --- Bancos das clínicas ----------------------------------------------------
#
# Credenciais que uma clínica NOVA herda ao ser provisionada. Fixado em
# 127.0.0.1, todas as clínicas nascem no mesmo servidor — é o desenho de um
# SaaS self-hosted.
#
# O nome do banco (`TENANT_DB_PREFIX` + id) NÃO PODE mudar depois que a
# primeira clínica entrar em produção: as conexões já registradas em
# `tenant_connections` passariam a apontar para bancos inexistentes.
TENANT_DB_DRIVER=mysql
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=saas <<<
TENANT_DB_PASSWORD= <<<
TENANT_DB_PREFIX=clinic_
TENANT_DB_PADDING=6
TENANT_GRACE_PERIOD_DAYS=7
TENANT_UPLOADS_PATH=uploads

# --- Super admin do painel --------------------------------------------------
#
# Usado SÓ na primeira `db:seed`, que cria a conta. Depois disso o seeder nunca
# mais mexe na senha — trocar é por `php artisan tpasswd` ou pelo painel.
# <<<
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD= <<<

# --- Sessão -----------------------------------------------------------------
#
# SESSION_SECURE_COOKIE=true só funciona sob HTTPS. Com ele em false e o site
# no ar sem TLS, o cookie de sessão trafega em claro e qualquer um na rede
# copia a sessão de uma clínica.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# --- Fila e cache -----------------------------------------------------------
#
# `database` não exige nenhum serviço extra na VPS. Só troque para `redis` se
# houver volume que justifique manter o Redis instalado emonitorado.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Se for usar redis:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD= <<<
# REDIS_PORT=6379

# --- Arquivos ---------------------------------------------------------------
#
# `local` grava em storage/app/private. Para backup e assinatura de URL o
# `FILESYSTEM_DISK=s3` é o esperado, mas depende do bucket existir.
FILESYSTEM_DISK=local

# --- E-mail -----------------------------------------------------------------
#
# `log` em produção significa que recuperação de senha e aviso de agendamento
# não chegam a ninguém: o usuário pede o link e ele nunca existe. Configure
# SMTP real (Mailgun/Resend/SES) antes de receber o primeiro cliente.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.seuprovedor.com
MAIL_PORT=587
MAIL_USERNAME= <<<
MAIL_PASSWORD= <<<
MAIL_FROM_ADDRESS="contato@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --- WhatsApp / Meta --------------------------------------------------------
#
# WHATSAPP_VERIFY_TOKEN é um segredo que VOCÊ inventa e que precisa estar com o
# mesmo valor cadastrado no painel da Meta. A Meta manda o hub.verify_token no
# GET de assinatura; se bater, devolve o hub.challenge e o webhook é validado.
#
# META_APP_SECRET assina o corpo do POST em X-Hub-Signature-256. Sem ele a rota
# recusa todo POST com 403 — uma rota pública sem assinatura deixaria qualquer
# pessoa criar paciente e agendamento pelo endpoint da Meta.
#
# Até ligar a integração de fato, deixe estes vazios.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN= <<<
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_API_TOKEN=
AI_PROVIDER=gemini
AI_API_KEY=

# --- Frontend ---------------------------------------------------------------
#
# `VITE_*` é lida no BUILD, não em runtime. Mudar aqui só vale se refizer
# `npm run build`. Em produção, defina no servidor e gere o build lá.
VITE_APP_NAME="${APP_NAME}"
