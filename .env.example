APP_NAME=SCO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco central do SaaS: clínicas, usuários, planos, assinaturas e as conexões
# de cada clínica. Nenhum dado clínico fica aqui.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_central
DB_USERNAME=saas
DB_PASSWORD=

# Banco por clínica. O usuário acima precisa de CREATE DATABASE para que o
# comando `php artisan tenant:create` possa criar o banco de uma clínica nova.
TENANT_DB_PREFIX=clinic_
TENANT_DB_PADDING=6
TENANT_GRACE_PERIOD_DAYS=7
TENANT_UPLOADS_PATH=uploads

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Credenciais do app da Meta (WhatsApp, Instagram, Facebook) e do modelo de IA.
# Ficam no banco da clínica, criptografadas — aqui só o padrão do sistema.
META_APP_ID=
META_APP_SECRET=
AI_PROVIDER=gemini
AI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
