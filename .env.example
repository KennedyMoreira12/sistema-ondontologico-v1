APP_NAME="LJ SmartClinic"
APP_TAGLINE="Plataforma de Gestão para Clínicas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco central do SaaS: clínicas, usuários, planos, assinaturas e as conexões
# de cada clínica. Nenhum dado clínico fica aqui.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_central
DB_USERNAME=saas
DB_PASSWORD=

# Servidor MySQL onde os bancos das clínicas são criados. Estas são as
# credenciais que uma clínica NOVA herda ao ser provisionada, e o usuário acima
# precisa de CREATE DATABASE para que `php artisan tenant:create` consiga criar
# o banco dela. Fixado em 127.0.0.1, todas as clínicas nascem no mesmo servidor,
# que é o desenho de um SaaS self-hosted.
TENANT_DB_DRIVER=mysql
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=saas
TENANT_DB_PASSWORD=

# sqlite em vez de mysql grava o banco de cada clínica como arquivo em
# TENANT_DB_DIRECTORY (padrão: database/tenants). Só para desenvolvimento.
# TENANT_DB_DRIVER=sqlite
# TENANT_DB_DIRECTORY=

TENANT_DB_PREFIX=clinic_
TENANT_DB_PADDING=6
TENANT_GRACE_PERIOD_DAYS=7
TENANT_UPLOADS_PATH=uploads

# Super admin do painel da empresa (/painel). Criado pelo AdminUserSeeder na
# primeira `db:seed`; as credenciais nunca são trocadas de novo pelo seeder, só
# adicionadas. TROQUE A SENHA antes de qualquer ambiente que não seja local.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@ljsmartclinic.com.br
ADMIN_PASSWORD=troque-esta-senha

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Credenciais do app da Meta (WhatsApp, Instagram, Facebook) e do modelo de IA.
# Ficam no banco da clínica, criptografadas — aqui só o padrão do sistema.
#
# AI_API_KEY é a chave do provedor de IA usada pelo atendimento do WhatsApp
# (config/services.php -> atendimento_ia). Sem ela o ClienteIA se declara não
# configurado e o fluxo determinístico assume — nenhuma mensagem fica sem
# resposta. As demais chaves desta seção ainda não são lidas por código algum.
WHATSAPP_API_TOKEN=
META_APP_ID=
META_APP_SECRET=
AI_PROVIDER=openrouter
AI_API_KEY=

# --- Atendimento com IA (config/services.php -> atendimento_ia) ---------------------
#
# ATENDIMENTO_IA_ENABLED nasce `false`: o bot do atendimento fica pausado até a
# credencial existir e alguém ligar a chave de propósito. NÃO ligue isto para
# ativar o atendimento em produção — a ativação do bot é uma decisão de operação,
# e a rota só responde quando o workflow do n8n também estiver ativo.
#
# AI_API_KEY é a chave do provedor (OpenRouter). AI_MODEL mantém o mesmo modelo
# do gerador de conteúdo social, salvo decisão explícita de troca.
ATENDIMENTO_IA_ENABLED=false
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=meta-llama/llama-3.3-70b-instruct
ATENDIMENTO_IA_TIMEOUT=30
ATENDIMENTO_IA_MAX_TOKENS=500
ATENDIMENTO_IA_TEMPERATURE=0.3
ATENDIMENTO_IA_MAX_POR_CONVERSA=30

# WhatsApp Cloud API (app/Http/Controllers/Api/MetaWebhookController.php).
#
# WHATSAPP_VERIFY_TOKEN é o segredo que você mesmo inventa e que o mesmo valor
# precisa estar cadastrado no painel da Meta. A Meta manda o hub.verify_token no
# GET de assinatura; se bater, devolve o hub.challenge e o webhook fica validado.
# Gere algo longo e aleatório — nada de "teste" ou "quero".
#
# META_APP_SECRET assina o corpo do POST em X-Hub-Signature-256. Sem ele a rota
# recusa todo POST com 403, porque uma rota pública sem assinatura deixaria
# qualquer pessoa criar paciente e agendamento pelo endpoint da Meta.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Evolution API (app/Services/EvolutionService.php) -------------------------------
#
# EVOLUTION_API_URL é a instalação da Evolution que hospeda as instâncias das
# clínicas. Sem barra no final.
#
# O token NÃO fica aqui. A Evolution tem chave global e token por instância, e o
# Laravel usa só o segundo: a chave global daria a qualquer chamada autoridade
# sobre as instâncias de TODAS as clínicas. O token por instância fica em
# clinics.evolution_token, cifrado, e é cadastrado pelo painel da empresa ou pelo
# comando `php artisan tenant:create --instance=`.
#
# EVOLUTION_WEBHOOK_SECRET é o segredo que autentica a Evolution chamando esta
# aplicação. A Evolution não assina o webhook com HMAC, então a rota confia neste
# valor no header X-Evolution-Secret — configurado como header fixo no webhook de
# cada instância — E no token da instância que vem no corpo. Vazio = webhook
# fechado, e todo POST responde 403.
#
# Gere algo longo e aleatório. O mesmo valor precisa estar no header do webhook
# de cada instância, senão a Evolution entrega e o Laravel recusa.
EVOLUTION_API_URL=
EVOLUTION_API_TIMEOUT=30
EVOLUTION_WEBHOOK_SECRET=

# --- n8n (app/Services/N8nDispatcher.php) --------------------------------------------
#
# Webhook do workflow de atendimento. O Laravel entrega o evento já resolvido
# (clínica, instância, mensagem, telefone), então o n8n não precisa manter mapa
# de instância para clínica.
#
# N8N_WEBHOOK_TOKEN é opcional: com ele a chamada leva X-N8n-Token. Sem ele a
# integração continua funcionando, o que basta quando o n8n só é alcançável pela
# rede interna.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"

# --- Fiscal (app/Services/Fiscal, config/fiscal.php) --------------------------------
#
# `mock` gera chave e XML locais e NAO tem validade fiscal: serve para homologar
# o fluxo inteiro. Para emitir de verdade troque FISCAL_PROVIDER e preencha a
# credencial do provedor escolhido (sendnf, focusnfe, nfeio ou plugnotas).
FISCAL_PROVIDER=mock
FISCAL_AMBIENTE=homologacao
FISCAL_SERIE=1
FISCAL_REGIME_TRIBUTARIO=simples
FISCAL_ALIQUOTA_ISS=5.0
FISCAL_CODIGO_SERVICO=4.03
FISCAL_DESCRICAO_SERVICO="Servicos odontologicos prestados"
FISCAL_CODIGO_MUNICIPIO=
FISCAL_CONNECT_TIMEOUT=10
FISCAL_TIMEOUT=30

SENDFN_ENABLED=false
SENDFN_BASE_URL=
SENDFN_API_KEY=
SENDFN_COMPANY_ID=

FOCUSNFE_ENABLED=false
FOCUSNFE_BASE_URL=https://api.focusnfe.com.br
FOCUSNFE_TOKEN=

NFEIO_ENABLED=false
NFEIO_BASE_URL=https://api.nfe.io
NFEIO_API_KEY=
NFEIO_COMPANY_ID=

PLUGNOTAS_ENABLED=false
PLUGNOTAS_BASE_URL=https://api.plugnotas.com.br
PLUGNOTAS_API_KEY=
